# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
tfplan
tfplan.*
*.tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files containing sensitive values
*.tfvars
*.tfvars.json

# Keep example variable files
!*.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local environment files
.env
.env.*

# Private keys
*.pem
*.key

# macOS files
.DS_Store

